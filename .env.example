NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# Application traffic must go through PgBouncer in transaction mode.
# Port 6432 is PgBouncer (see docker-compose.yml); credentials match the
# `postgres` service's POSTGRES_USER/POSTGRES_PASSWORD (fintrack/fintrack).
DATABASE_URL="postgresql://fintrack:fintrack@localhost:6432/fintrack?pgbouncer=true"

# Migrations must connect directly to Postgres (port 5432), not PgBouncer.
DIRECT_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack"

# Optional. Defaults to DATABASE_URL for local development only.
READ_REPLICA_DATABASE_URL=

REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:8081

# Encrypts Gmail refresh tokens at rest. 32 bytes, base64.
#
# Left EMPTY on purpose. This used to ship a valid all-zero key with a comment
# asking you to replace it, which is exactly what nobody did — it was copied
# into a real .env and became the live key, with no entropy at all. An empty
# value fails validation and the app refuses to boot, which is the only
# instruction anybody reliably follows.
#
#   node -p "require('crypto').randomBytes(32).toString('base64')"
FIELD_ENCRYPTION_KEY_BASE64=

# RS256 pair. Required in production; loaded from a secrets provider there.
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
#
# Paste each file whole, BEGIN and END lines included.
JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PEM=

# Gmail capture. The redirect URI must ALSO be registered in the Google Cloud
# console under Credentials → your OAuth client → Authorised redirect URIs, or
# Google refuses the handoff with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/capture/email/oauth/callback

# Categorisation and the universal parser. Either key works; AI_PROVIDER picks
# between them when both are set.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
AI_PROVIDER=
