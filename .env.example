NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# Application traffic must go through PgBouncer in transaction mode.
# Port 6432 is PgBouncer (see docker-compose.yml); credentials match the
# `postgres` service's POSTGRES_USER/POSTGRES_PASSWORD (fintrack/fintrack).
DATABASE_URL="postgresql://fintrack:fintrack@localhost:6432/fintrack?pgbouncer=true"

# Migrations must connect directly to Postgres (port 5432), not PgBouncer.
DIRECT_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack"

# Optional. Defaults to DATABASE_URL for local development only.
READ_REPLICA_DATABASE_URL=

REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:8081

# 32-byte key, base64 encoded. Replace outside local development.
FIELD_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# PEM values are loaded from secrets provider in production.
JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PEM=
