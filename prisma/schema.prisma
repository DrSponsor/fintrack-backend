generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  phone               String?   @unique
  passwordHash        String?   @map("password_hash")
  googleId            String?   @unique @map("google_id")
  tier                Tier      @default(FREE)
  createdAt           DateTime  @default(now()) @map("created_at")
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  accounts               Account[]
  budgets                Budget[]
  reports                Report[]
  subscription           Subscription?
  merchantPreferences    UserMerchantPreference[]
  billingEvents          BillingEvent[]
  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?
  emailAccessLogs        EmailAccessLog[]
  gmailConnection        GmailConnection?

  @@map("users")
}

/// One connected inbox, belonging to a PERSON.
///
/// This used to live on Account — gmail_connected and gmail_token_enc — which
/// was backwards in three ways. A user with three accounts alerting to one
/// Gmail stored the same refresh token three times, so revoking was three
/// writes that could half-fail. The webhook fanned out one notification into
/// one job per account, multiplying Gmail quota and parsing by the number of
/// accounts. And an account had to EXIST before its inbox could be connected,
/// which forced someone to type a bank name and four digits before the app had
/// any way to check them — the exact step account discovery exists to remove.
///
/// An inbox belongs to a person. Their accounts are discovered from it.
model GmailConnection {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// The Gmail address actually authorised, which need NOT be the address the
  /// user signed up with. The webhook resolves by this field; resolving by
  /// User.email silently missed anyone who connected a different mailbox.
  emailAddress String @map("email_address")

  /// Encrypted refresh token. Never logged — see core/logger/redact.ts.
  tokenEnc String @map("token_enc")

  /// Gmail history cursor, so a sync resumes rather than re-reading.
  historyId String? @map("history_id")

  /// Gmail watches expire after seven days and are renewed by a worker.
  watchExpiresAt DateTime? @map("watch_expires_at")

  connectedAt DateTime @default(now()) @map("connected_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailAddress])
  @@map("gmail_connections")
}

model Account {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  bankName            String        @map("bank_name")
  /// The last four digits, when the user typed them. Nullable because a
  /// DISCOVERED account has only what the bank revealed — Access prints three —
  /// and padding it to four would invent a digit the bank never gave us, in the
  /// very field used to decide which account an alert belongs to.
  accountLast4        String?       @map("account_last4")
  /// The masked number exactly as the bank prints it, e.g. 012******345.
  /// Preferred over accountLast4 for display and attribution alike: it is the
  /// bank's own statement rather than somebody's recollection of it.
  accountMask         String?       @map("account_mask")
  /// The account holder as the bank states it. Also the signal that a transfer
  /// went to the user themselves rather than to another person.
  holderName          String?       @map("holder_name")
  verifiedAt          DateTime?     @map("verified_at")
  verificationSource  AccountVerification @default(SELF_DECLARED) @map("verification_source")
  accountType         AccountType   @map("account_type")
  captureMethod       CaptureMethod @map("capture_method")
  gmailConnected      Boolean       @default(false) @map("gmail_connected")
  gmailTokenEnc       String?       @map("gmail_token_enc")
  balanceKobo         BigInt        @default(0) @map("balance_kobo")
  lastTransactionDate DateTime?     @map("last_transaction_date")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  emailAccessLogs EmailAccessLog[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id              String          @default(uuid()) @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  amountKobo      BigInt          @map("amount_kobo")
  type            TransactionType
  merchantName    String          @map("merchant_name")
  categoryId      String          @map("category_id") @db.Uuid
  transactionDate DateTime        @map("transaction_date")
  source          CaptureSource
  parserId        String?         @map("parser_id") @db.Uuid
  rawSnippetEnc   String?         @map("raw_snippet_enc")
  isVerified      Boolean         @default(false) @map("is_verified")
  /// The bank's own id for this transaction, when its alert states one. The
  /// only field that can settle whether two alerts describe the same payment
  /// by equality rather than judgement. Not unique: TimescaleDB requires every
  /// unique index to include the partition key, so uniqueness is enforced in
  /// the application — see PrismaTransactionRepository.findByProviderRef.
  providerRef     String?         @map("provider_ref")
  /// Links the two sides of money moved between the user's own accounts.
  /// Both rows stay: each is a real alert from a different bank and each is
  /// true from that bank's point of view. What is wrong is counting one as
  /// income and the other as spending, so aggregates exclude any row carrying
  /// this. Nullable, because most transactions are not transfers.
  transferGroupId String?         @map("transfer_group_id") @db.Uuid
  idempotencyKey  String          @map("idempotency_key")
  createdAt       DateTime        @default(now()) @map("created_at")

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category           @relation(fields: [categoryId], references: [id])
  events   TransactionEvent[]
  alerts   BudgetAlert[]

  @@id([id, transactionDate])
  @@unique([idempotencyKey, transactionDate])
  @@index([accountId, transactionDate])
  @@index([categoryId, transactionDate])
  @@index([accountId, providerRef])
  @@index([transferGroupId])
  @@map("transactions")
}

model TransactionEvent {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @map("transaction_id") @db.Uuid
  transactionDate DateTime @map("transaction_date")
  type            String
  payload         Json
  previousHash    String   @map("previous_hash")
  hash            String
  createdAt       DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId, transactionDate], references: [id, transactionDate], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@map("transaction_events")
}

model BudgetAlert {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @map("transaction_id") @db.Uuid
  transactionDate DateTime @map("transaction_date")
  budgetId        String   @map("budget_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId, transactionDate], references: [id, transactionDate], onDelete: Cascade)
  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([transactionId, budgetId])
  @@index([userId])
  @@map("budget_alerts")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable slug. Used for lookups and never shown to a person.
  name        String   @unique
  /// What a person reads. Lives here rather than in each client so adding a
  /// category is one change, and so two clients cannot disagree about what a
  /// category is called.
  displayName String   @map("display_name")
  icon        String
  createdAt   DateTime @default(now()) @map("created_at")

  transactions        Transaction[]
  keywords            CategoryKeyword[]
  merchantMappings    MerchantCategoryMap[]
  merchantPreferences UserMerchantPreference[]
  budgets             Budget[]

  @@map("categories")
}

model CategoryKeyword {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  keyword    String
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, keyword])
  @@index([keyword])
  @@map("category_keywords")
}

model MerchantCategoryMap {
  id                  String                @id @default(uuid()) @db.Uuid
  merchantFingerprint String                @unique @map("merchant_fingerprint")
  categoryId          String                @map("category_id") @db.Uuid
  source              MerchantMappingSource @default(SEEDED)
  confidence          Int                   @default(100)
  confirmedByUsers    Int                   @default(0) @map("confirmed_by_users")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("merchant_category_maps")
}

model UserMerchantPreference {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  merchantFingerprint String   @map("merchant_fingerprint")
  categoryId          String   @map("category_id") @db.Uuid
  correctionCount     Int      @default(1) @map("correction_count")
  lastCorrectedAt     DateTime @default(now()) @map("last_corrected_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, merchantFingerprint])
  @@index([categoryId])
  // Consensus is counted by fingerprint across ALL users. The unique index
  // above leads with userId, so it cannot serve that query — without this,
  // every correction triggers a sequential scan of the whole table.
  @@index([merchantFingerprint])
  @@map("user_merchant_preferences")
}

model Budget {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  categoryId String     @map("category_id") @db.Uuid
  limitKobo  BigInt     @map("limit_kobo")
  periodType PeriodType @map("period_type")
  createdAt  DateTime   @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id])
  alerts   BudgetAlert[]

  @@index([userId, periodType])
  @@index([categoryId])
  @@map("budgets")
}

model ParserPattern {
  id               String        @id @default(uuid()) @db.Uuid
  senderDomain     String        @unique @map("sender_domain")
  bankName         String        @map("bank_name")
  status           PatternStatus
  patterns         Json
  aiGenerated      Boolean       @map("ai_generated")
  confirmedByUsers Int           @default(0) @map("confirmed_by_users")
  version          Int           @default(1)
  lastValidated    DateTime      @map("last_validated")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("parser_patterns")
}

model Report {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  periodType    PeriodType @map("period_type")
  periodStart   DateTime   @map("period_start")
  periodEnd     DateTime   @map("period_end")
  isStale       Boolean    @default(false) @map("is_stale")
  schemaVersion Int        @default(1) @map("schema_version")
  data          Json
  generatedAt   DateTime   @default(now()) @map("generated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodType, periodStart])
  @@index([userId, periodType])
  @@map("reports")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @map("request_id")
  userId       String   @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  ipAddress    String   @map("ip_address")
  userAgent    String   @map("user_agent")
  metadata     Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// NDPR transparency requirement — records every email the system accessed
/// for a user via the Gmail capture pipeline, and what happened to it.
/// User-facing (GET /v1/privacy/email-access-log), not an internal audit
/// trail — deliberately separate from AuditLog, which covers API-route
/// actions and is anonymised (not deleted) on account deletion. Email
/// access logs carry no internal audit value once the account is gone,
/// so they are hard-deleted in the account deletion cascade instead.
model EmailAccessLog {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  /// Which account the email turned out to concern, when that is knowable.
  /// Null when the app read an email and could not attribute it — mail the
  /// safety gate discarded, mail with no transaction in it, and alerts naming
  /// an account the user has not registered. Access is per-INBOX now, so the
  /// account is incidental to the record; making it mandatory would mean
  /// inventing an attribution to satisfy a constraint, in a table whose whole
  /// purpose is to tell the user truthfully what was read.
  accountId    String?            @map("account_id") @db.Uuid
  messageId    String             @map("message_id")
  senderDomain String             @map("sender_domain")
  subject      String
  outcome      EmailAccessOutcome
  accessedAt   DateTime           @default(now()) @map("accessed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, accessedAt])
  @@map("email_access_logs")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  provider               BillingProvider
  providerCustomerId     String             @map("provider_customer_id")
  providerSubscriptionId String             @unique @map("provider_subscription_id")
  providerPlanId         String             @map("provider_plan_id")
  status                 SubscriptionStatus
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  cancelledAt            DateTime?          @map("cancelled_at")
  gracePeriodEndsAt      DateTime?          @map("grace_period_ends_at")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([status, gracePeriodEndsAt])
  @@map("subscriptions")
}

model BillingEvent {
  id               String          @id @default(uuid()) @db.Uuid
  provider         BillingProvider
  providerEventId  String          @unique @map("provider_event_id")
  eventType        String          @map("event_type")
  normalizedType   String          @map("normalized_type")
  userId           String?         @map("user_id") @db.Uuid
  anonymizedUserId String?         @map("anonymized_user_id") @db.Uuid
  payload          Json
  processed        Boolean         @default(false)
  processedAt      DateTime?       @map("processed_at")
  processingError  String?         @map("processing_error")
  createdAt        DateTime        @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([processed, createdAt])
  @@map("billing_events")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)

  @@index([publishedAt, attempts])
  @@map("outbox_events")
}

enum Tier {
  FREE
  PRO
}

enum AccountType {
  CURRENT
  SAVINGS
  WALLET
}

/// How much the app actually knows about an account belonging to this user.
///
/// Neither value is proof of ownership, and the field is a source rather than
/// a boolean so nothing in the system can claim more certainty than it has.
/// EMAIL_DISCOVERY says a bank sent an alert naming this account to this
/// person's connected inbox and the person confirmed it — which a forwarded
/// alert or a shared family inbox still defeats.
enum AccountVerification {
  /// Typed into a form. No evidence at all.
  SELF_DECLARED
  /// Found in an alert delivered to the user's inbox, then confirmed by them.
  EMAIL_DISCOVERY
}

enum CaptureMethod {
  EMAIL
  MANUAL
  SMS
  MONO
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum CaptureSource {
  EMAIL
  MANUAL
  SMS
  MONO
}

enum PeriodType {
  WEEKLY
  MONTHLY
}

enum PatternStatus {
  LEARNING
  STABLE
}

enum BillingProvider {
  PAYSTACK
  MONNIFY
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  CANCELLED
  EXPIRED
}

enum MerchantMappingSource {
  SEEDED
  USER_CORRECTION
  AI_CONFIRMED
}

enum EmailAccessOutcome {
  TRANSACTION_CREATED
  DUPLICATE_SUPPRESSED
  DISCARDED_SAFETY_FILTER
  DISCARDED_NO_KEYWORDS
  PARSE_FAILED
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @map("platform") // 'ANDROID' | 'IOS'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model NotificationPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  budgetAlerts         Boolean  @default(true) @map("budget_alerts")
  paymentFailures      Boolean  @default(true) @map("payment_failures")
  subscriptionExpiring Boolean  @default(true) @map("subscription_expiring")
  weeklyReports        Boolean  @default(true) @map("weekly_reports")
  monthlyReports       Boolean  @default(true) @map("monthly_reports")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
